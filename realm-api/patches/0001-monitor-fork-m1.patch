@@ -22,6 +22,23 @@ use realm_core::udp::run_udp;
 
 pub const ENV_API_KEY: &str = "REALM_API_KEY";
 
+/// monitor fork (m1): 常量时间字节比较（长度不等直接否——key 定长 hex，不泄长度）。
+fn constant_time_eq(a: &str, b: &str) -> bool {
+    let (a, b) = (a.as_bytes(), b.as_bytes());
+    if a.len() != b.len() {
+        return false;
+    }
+    a.iter().zip(b.iter()).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
+}
+
+/// monitor fork (m1): 客户端指定的实例 id 白名单——id 会出现在持久化文件与
+/// 日志里，且 GET/DELETE 按路径段解析，只允许安全字符。
+fn valid_instance_id(id: &str) -> bool {
+    !id.is_empty()
+        && id.len() <= 64
+        && id.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_')
+}
+
 static X_API_KEY: HeaderName = HeaderName::from_static("x-api-key");
 
 async fn auth_middleware(
@@ -37,7 +54,8 @@ async fn auth_middleware(
     if let Some(api_key_header) = headers.get(&X_API_KEY) {
         if let Ok(provided_key) = api_key_header.to_str() {
             if let Some(expected_key) = &state.api_key {
-                if provided_key == expected_key {
+                // monitor fork (m1): 常量时间比较，避免计时侧信道逐字节猜 key。
+                if constant_time_eq(provided_key, expected_key) {
                     return Ok(next.run(request).await);
                 }
             }
@@ -236,13 +254,22 @@ async fn list_instances(State(state): State<AppState>) -> Json<Vec<Instance>> {
 
 async fn create_instance(
     State(state): State<AppState>,
-    Json(mut config): Json<EndpointConf>,
+    Json(mut body): Json<serde_json::Value>,
 ) -> Result<Json<Instance>, StatusCode> {
+    // monitor fork (m1): 支持客户端指定实例 id（管控面对账需要稳定的
+    // 「规则 id ↔ 实例」映射）；缺省回落 uuid 保持上游行为。
+    let client_id = match body.get("id").and_then(|v| v.as_str()) {
+        Some(id) if valid_instance_id(id) => Some(id.to_owned()),
+        Some(_) => return Err(StatusCode::UNPROCESSABLE_ENTITY),
+        None => None,
+    };
+    let mut config: EndpointConf =
+        serde_json::from_value(body).map_err(|_| StatusCode::UNPROCESSABLE_ENTITY)?;
     if let Some(global_config) = &state.global_config {
         config.network.take_field(&global_config.network);
     }
 
-    let id = uuid::Uuid::new_v4().to_string();
+    let id = client_id.unwrap_or_else(|| uuid::Uuid::new_v4().to_string());
     let instance = Instance {
         id: id.clone(),
         config: config.clone(),
@@ -272,6 +299,16 @@ async fn create_instance(
     };
 
     let mut instances = state.instances.lock().await;
+    // monitor fork (m1): id 冲突显式 409（上游 uuid 撞不出来，客户端 id 会撞）。
+    if instances.contains_key(&id) {
+        if let Some(h) = tcp_handle {
+            h.abort();
+        }
+        if let Some(h) = udp_handle {
+            h.abort();
+        }
+        return Err(StatusCode::CONFLICT);
+    }
     instances.insert(
         id,
         InstanceData {
@@ -387,6 +424,14 @@ async fn start_instance(State(state): State<AppState>, Path(id): Path<String>) -
                 return Err(StatusCode::CONFLICT);
             }
         }
+        // monitor fork (m1): Failed 态可能残留旧任务句柄，重生前必须 abort，
+        // 否则句柄泄漏（上游只在 update/delete/stop 里 abort）。
+        if let Some(h) = data.tcp_handle.take() {
+            h.abort();
+        }
+        if let Some(h) = data.udp_handle.take() {
+            h.abort();
+        }
 
         let endpoint_info = data.instance.config.clone().build();
         let (tcp_handle, udp_handle) = match start_realm_endpoint(endpoint_info) {
@@ -683,7 +728,8 @@ pub async fn start_api_server(
         .merge(api_routes)
         .with_state(state);
 
-    let addr = format!("0.0.0.0:{}", port);
+    // monitor fork (m1): API 只服务本机管控面（agent 经回环调用），绝不暴露公网。
+    let addr = format!("127.0.0.1:{}", port);
     if let Some(_key) = &api_key {
         println!("Starting API server on {} with authentication enabled", addr);
         println!("API key loaded from REALM_API_KEY environment variable");
